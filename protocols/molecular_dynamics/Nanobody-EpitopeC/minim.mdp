integrator  = steep
emtol       = 100.0      ; Antes estaba en 1000.0 (más estricto)
emstep      = 0.01
nsteps      = 200000     ; Duplicamos los pasos para darle tiempo
cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 10
rcoulomb        = 1.0
rvdw            = 1.0
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16
DispCorr        = EnerPres
pbc             = xyz


