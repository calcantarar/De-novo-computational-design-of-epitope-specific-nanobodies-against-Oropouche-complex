title                  = NVT equilibration
define                 = -DPOSRES
integrator             = md
nsteps                 = 100000
dt                     = 0.001
nstlog                 = 5000
nstenergy              = 5000
nstxout-compressed     = 5000
compressed-x-grps      = System
continuation           = no
cutoff-scheme          = Verlet
nstlist                = 10
rcoulomb               = 1.0
rvdw                   = 1.0
coulombtype            = PME
pme_order              = 4
fourierspacing         = 0.16
DispCorr               = EnerPres
pbc                    = xyz
constraints            = h-bonds
constraint_algorithm   = lincs
lincs_iter             = 1
lincs_order            = 4
tcoupl                 = V-rescale
tc-grps                = Protein Non-Protein
tau_t                  = 0.1 0.1
ref_t                  = 300.0 300.0
pcoupl                 = no
gen_vel                = yes
gen_temp               = 300.0
gen_seed               = -1
nstcomm                = 100
comm-mode              = Linear
comm-grps              = Protein Non-Protein
